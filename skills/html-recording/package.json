{
  "name": "html-recording",
  "version": "0.2.0",
  "description": "Record web pages as HTML (the real DOM, via rrweb) instead of video, edit them in Recording Studio, cut them into sizzle reels, and play them anywhere.",
  "keywords": ["rrweb", "screen recording", "replay", "demo", "walkthrough", "playwright", "screen studio", "sizzle reel"],
  "type": "module",
  "bin": { "html-recording": "cli.mjs" },
  "exports": {
    ".": "./tools/rrlib.mjs",
    "./edits": "./tools/player/edits.js",
    "./player/html-recording.js": "./tools/player/html-recording.js",
    "./player/edits.js": "./tools/player/edits.js",
    "./player/rrweb-replay.min.js": "./tools/player/rrweb-replay.min.js",
    "./player/reel.js": "./tools/player/reel.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cli.mjs",
    "tools/*.mjs",
    "tools/player/",
    "studio/server.mjs",
    "studio/dist/",
    "examples/",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@rrweb/record": "2.1.7",
    "playwright": "^1.56.0"
  },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/GChainey/skills.git", "directory": "skills/html-recording" },
  "homepage": "https://garethchainey.com/replay-vs-video",
  "author": "Gareth Chainey (https://garethchainey.com)",
  "license": "MIT"
}
